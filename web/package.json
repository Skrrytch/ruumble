{
  "name": "@ruumble/web",
  "version": "0.24.0",
  "private": true,
  "description": "Ruumble web UI (Svelte)",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo --base=./ --outDir dist-demo",
