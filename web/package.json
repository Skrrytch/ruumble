    "@lucide/svelte": "1.48.0",
    "@ruumble/protocol": "workspace:*",
    "dompurify": "3.4.16",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.3",
    "@vitest/coverage-v8": "5.0.2",
    "jsdom": "30.1.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
